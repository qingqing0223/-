{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicOpinionMonitorV2Output",
  "type": "object",
  "required": ["status", "type"],
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["normal", "attention", "problematic"]},
    "type": {
      "type": "string",
      "enum": ["support", "neutral", "information_gap", "consultation", "concern", "criticism", "skepticism", "implementation_issue", "fairness_dispute", "complaint_rights", "discriminatory_expression"]
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "normal"}}}, "then": {"properties": {"type": {"const": "support"}}}},
    {"if": {"properties": {"status": {"const": "attention"}}}, "then": {"properties": {"type": {"enum": ["neutral", "information_gap", "consultation"]}}}},
    {"if": {"properties": {"status": {"const": "problematic"}}}, "then": {"properties": {"type": {"enum": ["concern", "criticism", "skepticism", "implementation_issue", "fairness_dispute", "complaint_rights", "discriminatory_expression"]}}}}
  ]
}
